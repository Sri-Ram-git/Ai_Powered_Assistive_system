# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/*.log

# Assets — NEVER push personal media, photos, faces, screenshots,
# or recordings to the repository.  Keep only placeholder .gitkeep files.
assets/*
!assets/**/
!assets/**/.gitkeep

# Screenshots & recordings (defensive, in case paths change)
assets/screenshots/*
assets/sample_videos/*
assets/sample_images/*
src/image_fundamentals/sample_images/*
# Allow the repo's own synthetic sample scene (no personal media)
!src/image_fundamentals/sample_images/test_scene.png

# OS
.DS_Store
Thumbs.db

# Config overrides
*.local.yaml

# Models — large downloaded weights, re-downloaded via config
models/*.onnx

# Distribution / build
dist/
build/
*.egg-info/
