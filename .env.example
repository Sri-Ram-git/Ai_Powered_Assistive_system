# Environment template — copy to .env and fill in REAL deployments only.
# Never commit the real .env.  All of these are OPTIONAL: the core app
# runs fully offline with no cloud credentials.
#
# Remote VLM (optional).  When configured, the RemoteVLM backend calls a
# cloud model to describe scenes; falls back to the offline deterministic
# describer on any error/timeout.  Leave empty to stay fully offline.
VLM_API_URL=
VLM_API_KEY=

# Optional cloud STT (FasterWhisper local model path, NOT a key).
# STT_KEYWORD backend needs no model and works offline out of the box.
WHISPER_MODEL_PATH=

# Web dashboard host/port overrides.
ASSIST_HOST=127.0.0.1
ASSIST_PORT=5000